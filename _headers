# Netlify HTTP response headers.
# https://docs.netlify.com/routing/headers/
#
# Security baseline for chainmore.io. Targets `securityheaders.com` A+
# and Mozilla Observatory ≥100/100. Each header is justified inline so
# an auditor (DORA / GDPR Art. 32 / PSD2) can read the rationale next
# to the value.
#
# Scope: marketing site only. Dashboards (merchant, treasury) ship
# their own CSP via next.config.js because their connect-src and
# frame-src must include the Keycloak + gateway hosts at build time.
#
# ─────────────────────────────────────────────────────────────────────
# STAGED-ROLLOUT POSTURE (per GPT review 2026-04-29)
#
# This file has completed the initial conservative rollout steps:
#
#   - HSTS max-age=15768000 (6 months, NOT 2 years)
#   - HSTS without `preload` directive
#   - CSP enforced (marketing site has no auth/cookies → safe to enforce)
#
# Historical ramp procedure:
#
#   day 0   first deploy:      max-age=300                — verify HTTPS
#                                                          doesn't break
#   day 1   after smoke pass:  max-age=86400              — 1-day commit
#   day 7   after smoke pass:  max-age=2592000            — 30-day commit
#   current deployed posture:  max-age=15768000           — 6-month commit
#   future + investor sign-off:
#                              max-age=63072000; preload  — submit to
#                                                          hstspreload.org
#
# When ramping, edit this file in-place and re-deploy. preload is a
# one-way door — removal from the preload list takes 12+ months.
# ─────────────────────────────────────────────────────────────────────

/*
  # ── Transport security ────────────────────────────────────────────
  # HSTS is now on the 6-month ramp step without preload. See the
  # historical ramp procedure above. includeSubDomains is on because if
  # any subdomain (api., auth., app.) is served over http, we want to
  # know immediately. The preload directive remains off until the
  # explicit preload sign-off step.
  Strict-Transport-Security: max-age=15768000; includeSubDomains

  # ── Content Security Policy ───────────────────────────────────────
  # default-src 'self' — start by allowing only same-origin assets,
  # then explicit per-directive carve-outs.
  #
  # script-src uses exact SHA-256 hashes for the static inline blocks
  # that remain in the marketing HTML (JSON-LD, Redoc init, hero/demo
  # interactions). No inline wildcard, no eval wildcard. Any inline JS
  # edit must update this header and pass scripts/marketing-csp-hash-check.js.
  #
  # style-src follows the same hash discipline for static inline <style>
  # blocks. Inline style attributes are forbidden by CI; use classes.
  #
  # connect-src 'self' — the marketing site makes zero fetch() /
  # XHR / WebSocket calls. Tightest possible.
  #
  # frame-ancestors 'none' — chainmore.io cannot be put in any iframe
  # (clickjacking defense; redundant with X-Frame-Options below but
  # frame-ancestors is the modern equivalent + survives in HTTP 3).
  #
  # form-action 'self' — forms can only submit back to chainmore.io;
  # blocks injected forms that exfiltrate to an attacker domain.
  #
  # upgrade-insecure-requests — auto-rewrite any accidentally http://
  # subresource to https://. Belt + braces with HSTS.
  # worker-src 'self' blob: — Redoc on /docs.html spawns Web Workers
  # for the in-page search index. The workers are created from blob:
  # URLs derived from the self-hosted Redoc bundle (already covered
  # by script-src 'self'). No third-party JS ever spawns a worker on
  # this site, so the blob: scope is bounded to our own bundle.
  # Other pages (index, pricing, status, legal/*) do not spawn workers
  # at all; the directive is permissive only where there is nothing
  # to permit. See ADR_SECURITY_HEADERS.md follow-ups if/when this
  # changes.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-8yiyZEox8CxR9dO7WBLm4Ra7x3cIgKA5Na6yuUVr6II=' 'sha256-Nj+P2qACuoraszVKeoGjtotMle7iSlJNVWsBV0KOfq4=' 'sha256-OaqrmoQg3cz1NijUm1BPp3G2/v3RV9Kp9S1ckooXyF4=' 'sha256-W2JUEHZyy3W+V5VfZyTiYdrJrEih05UDo+0kyJchLfM=' 'sha256-eX3XxiWoM7YhWlihhzgFiOXq252IkpU2MXGCnVWvHs0='; style-src 'self' 'sha256-/kaOULfzN1MmQBEMPTAh7G5Hj1Ixg5SHokLgiPetlzQ=' 'sha256-0ETkPuZCUWKHh8wtH4akk2DnHiBgizU2I62Wgo25p8w=' 'sha256-6tzp4ifN1wxmQ0y5f074+l6cwyZnCkLhoJEEopYNRW4=' 'sha256-AgMV/iTGVHsf/PUSKDb/Oyc0buDrWUOgNDJTNB01NCU=' 'sha256-H/7MI6x5O+vK7x6C3nB3idAvoJ1jdOAujmkoYa7GC9I=' 'sha256-NtwGSRDxwMaWqf3bhdJ2BA6YFK01SB2MtLR+FhQYVaw=' 'sha256-XiFpeu6cTsrUYKlJLfQGmKHpR2Z4TxAkH54BbHYmINo=' 'sha256-ewti0XyPtGYMPkeQIgGdAvLR3+tCq8oTavfdd9YcSdk=' 'sha256-mMd0zEQzpTlSBSON0eohIV+BnATuvxxDX/boRgPbJUs=' 'sha256-mucSbbxzqYFxnbM66GEiboLBbzblPMhgJGQ83LTHjYE=' 'sha256-muqd1az46vpaKe0tGNd+4W2aNl7pzXKKkyvOP6ULanY=' 'sha256-uIQy2KeRM63O0SSAl7pQMhN4aHGRX8pb1FqiSTgjbzU=' 'sha256-zAJNsLT09VNJJ4+nT0G9YCtEjhCkGcKUvSMHry7PN/E='; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; worker-src 'self' blob:; upgrade-insecure-requests

  # ── Frame / clickjacking ──────────────────────────────────────────
  # X-Frame-Options DENY — legacy header; modern browsers prefer
  # frame-ancestors above, but X-Frame-Options is still honoured by
  # older browsers and required by some compliance frameworks
  # (DORA Annex II, BSI IT-Grundschutz).
  X-Frame-Options: DENY

  # ── MIME-sniffing ─────────────────────────────────────────────────
  # nosniff — browser must trust our Content-Type header. Without
  # this, IE and older Chrome would try to "guess" types and could
  # execute a JSON file as JS if it happened to look like JS.
  X-Content-Type-Options: nosniff

  # ── Referrer ──────────────────────────────────────────────────────
  # strict-origin-when-cross-origin — keeps the full referrer for
  # same-origin navigations (useful for analytics); on cross-origin
  # only sends scheme + host + port (no path, no query). Prevents
  # leaking the user's current path to a clicked outbound link.
  # Falls back to no-referrer on protocol downgrade (https → http).
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Permissions Policy ────────────────────────────────────────────
  # Deny EVERY browser capability we don't actively use. If an
  # attacker injects script (despite all mitigations above), they
  # can't pop a getUserMedia prompt or read geolocation. We are a
  # payments service but the Web Payment API is browser-side
  # ApplePay/GooglePay/PaymentRequest — we don't use it; fully blocked.
  # interest-cohort=() opts out of FLoC / Topics API tracking.
  Permissions-Policy: accelerometer=(), ambient-light-sensor=(), autoplay=(), battery=(), camera=(), display-capture=(), document-domain=(), encrypted-media=(), execution-while-not-rendered=(), execution-while-out-of-viewport=(), fullscreen=(), geolocation=(), gyroscope=(), keyboard-map=(), magnetometer=(), microphone=(), midi=(), navigation-override=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), sync-xhr=(), usb=(), web-share=(), xr-spatial-tracking=(), interest-cohort=()

  # ── Cross-origin isolation ────────────────────────────────────────
  # COOP same-origin — when a user opens our page in a new top-level
  # window, that window is its OWN isolated process group. Prevents
  # cross-origin window.opener attacks (tabnabbing) and Spectre-style
  # leaks across processes.
  Cross-Origin-Opener-Policy: same-origin

  # CORP same-origin — our resources can only be loaded by
  # chainmore.io itself, never embedded by another site as <img>,
  # <script>, etc. Makes CDN-style hotlinking impossible.
  Cross-Origin-Resource-Policy: same-origin

# Long-cache the static assets. Headers above still apply because
# /* matches everything; this block only ADDS Cache-Control.
/tailwind.css
  Cache-Control: public, max-age=31536000, immutable

# robots.txt + sitemap.xml — short cache so updates propagate.
/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600

# RFC 9116 security.txt — must be served as text/plain. Netlify
# auto-detects most extensions but not .txt-with-no-charset, so we
# pin it explicitly. Short cache so a Contact / Expires update
# propagates within an hour.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# OpenAPI specs served from /api/*.yaml. Pin Content-Type so Redoc
# (and any other fetcher) parses them as YAML, not as text/plain or
# application/octet-stream. Short cache so a spec re-freeze
# propagates within an hour without a forced reload.
/api/*.yaml
  Content-Type: application/yaml; charset=utf-8
  Cache-Control: public, max-age=3600

# Redoc bundle. Self-hosted at /assets/redoc.standalone.js so the
# strict CSP (script-src 'self') can render the public docs at /docs
# without permitting any third-party CDN. Long-cache because the
# version is pinned at build time and a re-checkin invalidates by
# path-bust.
/assets/redoc.standalone.js
  Cache-Control: public, max-age=31536000, immutable
